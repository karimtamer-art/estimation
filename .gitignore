# Dart / Flutter build artifacts
.dart_tool/
.packages
.flutter-plugins-dependencies
build/
pubspec.lock

# Generated platform folders — recreate with `flutter create .`
# Anchored with a leading slash: unanchored, `ios/` also swallows
# design/icons/ios/, and the committed icons would silently vanish.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# IDE
.idea/
*.iml
.vscode/

# Local tooling
.claude/settings.local.json

# Secrets — never commit these
# .p8 = App Store Connect API private key (Apple allows ONE download, ever)
*.p8
*.p12
*.mobileprovision
*.cer
*.pem

# OS
.DS_Store
Thumbs.db
